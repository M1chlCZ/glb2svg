{
  "name": "glb2svg",
  "version": "0.3.0",
  "description": "Headless GLB-to-SVG renderer that produces deterministic, themeable fallback artwork without a browser or GPU.",
  "type": "module",
  "license": "MIT",
  "author": "m1chlcz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M1chlCZ/glb2svg.git"
  },
  "homepage": "https://github.com/m1chlcz/glb2svg#readme",
  "bugs": "https://github.com/m1chlcz/glb2svg/issues",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "glb2svg": "./bin/glb2svg.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "draco3dgltf": "1.5.7",
    "happy-dom": "^20.14.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
